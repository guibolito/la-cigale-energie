---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import DevisForm from '../../components/DevisForm.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const articles = await getCollection('blog', (a) => !a.data.brouillon);
  return articles.map((a) => ({ params: { slug: a.id }, props: { a } }));
}
const { a } = Astro.props as { a: CollectionEntry<'blog'> };
const { Content, headings } = await render(a);
const autres = (await getCollection('blog', (x) => !x.data.brouillon && x.id !== a.id))
  .sort((x, y) => y.data.date.getTime() - x.data.date.getTime())
  .slice(0, 3);
const url = new URL(`/blog/${a.id}`, Astro.site).href;
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const sommaire = headings.filter((h) => h.depth === 2);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: a.data.titre,
    description: a.data.description,
    datePublished: a.data.date.toISOString().slice(0, 10),
    dateModified: (a.data.maj ?? a.data.date).toISOString().slice(0, 10),
    inLanguage: 'fr-FR',
    keywords: a.data.motsCles.join(', '),
    mainEntityOfPage: url,
    image: new URL('/og.png', Astro.site).href,
    author: { '@type': 'Organization', name: site.name, url: new URL('/', Astro.site).href },
    publisher: { '@id': new URL('/#entreprise', Astro.site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Conseils', item: new URL('/blog', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: a.data.titre, item: url },
    ],
  },
];
---
<Layout title={`${a.data.titre} | ${site.name}`} description={a.data.description} jsonld={jsonld}>
  <section class="hero-dark">
    <div class="container-site max-w-4xl py-12 md:py-16">
      <nav aria-label="Fil d’Ariane" class="text-sm text-paper/60"><a href="/" class="hover:text-paper hover:underline">Accueil</a> <span aria-hidden="true">/</span> <a href="/blog" class="hover:text-paper hover:underline">Conseils</a></nav>
      <h1 class="mt-5 text-[clamp(2.1rem,6.5vw,3.5rem)] uppercase">{a.data.titre}</h1>
      <p class="mt-4 text-lg text-paper/80">{a.data.resume}</p>
      <p class="mt-5 text-sm text-paper/60">Publié le <time datetime={a.data.date.toISOString().slice(0, 10)}>{fmt(a.data.date)}</time>{a.data.maj && <> · mis à jour le {fmt(a.data.maj)}</>}</p>
    </div>
  </section>

  <div class="container-site grid gap-12 py-12 md:py-16 lg:grid-cols-[1fr_18rem]">
    <article class="prose-article min-w-0 max-w-3xl">
      <Content />
    </article>
    <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
      {sommaire.length > 2 && (
        <nav aria-label="Sommaire" class="card p-5">
          <p class="font-display text-xl font-bold uppercase">Sommaire</p>
          <ol class="mt-3 space-y-2 text-sm">
            {sommaire.map((h) => <li><a href={`#${h.slug}`} class="text-muted hover:text-accent-strong hover:underline">{h.text}</a></li>)}
          </ol>
        </nav>
      )}
      <div class="rounded-2xl bg-ink p-5 text-paper">
        <p class="font-display text-2xl font-bold uppercase leading-tight">Un projet de clim ?</p>
        <p class="mt-2 text-sm text-paper/75">Devis gratuit, prix ferme, réponse sous 24 h ouvrées.</p>
        <a href="#devis" class="btn btn-primary mt-4 w-full" data-track="CTA devis" data-place={`blog-${a.id}`}>Demander un devis</a>
        <a href="/calculateur-clim" class="mt-3 flex items-center justify-center gap-2 text-sm font-semibold text-accent hover:underline"><Icon name="target" size={16} /> Calculer ma puissance</a>
      </div>
    </aside>
  </div>

  {autres.length > 0 && (
    <section class="section bg-white" aria-labelledby="autres-titre">
      <div class="container-site">
        <h2 id="autres-titre" class="h2 uppercase">À lire aussi</h2>
        <ul class="mt-8 grid gap-5 md:grid-cols-3">
          {autres.map((x) => <li><ArticleCard slug={x.id} titre={x.data.titre} resume={x.data.resume} date={x.data.date} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <DevisForm />
</Layout>
