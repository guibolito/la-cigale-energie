---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import DevisForm from '../components/DevisForm.astro';
import EnergyVisual from '../components/EnergyVisual.astro';
import Etapes from '../components/Etapes.astro';
import Realisations from '../components/Realisations.astro';
import Avis from '../components/Avis.astro';
import VarMap from '../components/VarMap.astro';
import { site } from '../config/site';
import { services, afficherBientot, accueilGeneraliste } from '../config/services';
import HeroVisual from '../components/HeroVisual.astro';

const actifs = services.filter((s) => s.enabled);
const bientot = afficherBientot ? services.filter((s) => !s.enabled) : [];
const listeBientot = bientot.map((s) => s.name.toLowerCase()).join(', ').replace(/, ([^,]*)$/, ' et $1');
const nomsActifs = actifs.map((s) => s.name.toLowerCase()).join(', ');

const faq = [
  { q: 'Le devis est-il gratuit ?', a: 'Oui, et sans engagement. Après un échange et, si besoin, une visite ou quelques photos, vous recevez un devis écrit et détaillé, avec un prix ferme : c’est ce prix qui est facturé.' },
  { q: 'Quels travaux proposez-vous aujourd’hui ?', a: `Aujourd’hui : ${nomsActifs}.${bientot.length ? ` D’autres domaines ouvriront bientôt : ${listeBientot}.` : ''}` },
  { q: 'Sous quel délai répondez-vous ?', a: 'Nous répondons à chaque demande sous 24 h ouvrées. La date d’intervention est fixée avec vous et indiquée sur le devis.' },
  { q: 'Comment préparer ma demande ?', a: 'Indiquez votre commune, le type de logement et ce que vous souhaitez. Quelques photos de l’existant (emplacement prévu, ancien appareil, tableau électrique) nous aident à chiffrer plus vite : vous pouvez les envoyer par WhatsApp.' },
  { q: 'Où intervenez-vous ?', a: `Nous intervenons ${site.zoneText}. ${site.zoneFar}` },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const atouts = [
  ['doc', 'Devis gratuit', 'Écrit, détaillé, sans engagement'],
  ['shield', 'Prix ferme', 'Le prix du devis est celui facturé'],
  ['clock', 'Réponse en 24 h', 'Sur chaque demande, jours ouvrés'],
  ['pin', 'Var & alentours', 'Et plus loin sur demande'],
] as const;
const engagements = [
  ['user', 'Un seul interlocuteur', 'Le même contact du premier appel à la mise en service. Pas de plateforme, pas de relais.'],
  ['target', 'Le bon équipement', 'Puissance calculée pour votre logement. Nous vous déconseillons ce qui ne vous sert à rien.'],
  ['clock', 'Réactifs', 'Réponse sous 24 h ouvrées, rendez-vous fixé et respecté.'],
  ['pin', 'Proches de chez vous', 'Une équipe du Var : bord de mer, copropriétés, résidences secondaires, nous connaissons le terrain.'],
] as const;
const prestations = [
  ['ac', 'Installation', 'Clim mono ou multisplit, réversible.'],
  ['shield', 'Entretien', 'Visite ponctuelle ou contrat annuel.'],
  ['wrench', 'Dépannage', 'Diagnostic sur place, prix annoncé avant.'],
  ['swap', 'Remplacement', 'Ancien appareil déposé, fluides récupérés.'],
] as const;
---
<Layout
  title={accueilGeneraliste
    ? 'La Cigale Énergie | Énergie & confort de l’habitat dans le Sud de la France'
    : 'Climatisation dans le Sud de la France | La Cigale Énergie'}
  description={accueilGeneraliste
    ? `La Cigale Énergie : énergie et confort de l’habitat dans le Var et ses alentours. ${actifs.map((s) => s.name).join(', ')}${bientot.length ? ` dès maintenant, ${listeBientot} bientôt` : ''}. Devis gratuit, prix ferme, réponse sous 24 h ouvrées.`
    : 'La Cigale Énergie : pose, entretien, dépannage et remplacement de climatisation dans le Var et ses alentours. Devis gratuit, prix ferme, réponse sous 24 h ouvrées.'}
  jsonld={[faqLd]}
>
  <!-- HERO -->
  <section class="hero-dark">
    <div class="container-site grid items-center gap-14 pb-20 pt-12 md:grid-cols-[1.15fr_1fr] md:pb-28 md:pt-20">
      <div>
        <p class="eyebrow inline-flex items-center gap-2"><Icon name="pin" size={16} /> {site.region} et alentours</p>
        {accueilGeneraliste ? (
          <>
            <h1 class="mt-4 text-[clamp(2.6rem,9.5vw,4.4rem)] uppercase">
              Énergie & confort de l’habitat,<br /><span class="text-accent">près de chez vous.</span>
            </h1>
            <p class="mt-6 max-w-xl text-lg text-paper/80 md:text-xl">
              {[...actifs, ...bientot].map((s) => s.name).join(', ')} : un seul interlocuteur pour l’énergie et le confort de votre logement. Un devis écrit, un prix annoncé, un chantier propre.
            </p>
          </>
        ) : (
          <>
            <h1 class="mt-4 text-[clamp(2.6rem,9.5vw,4.4rem)] uppercase">
              Le frais l’été,<br />le chaud l’hiver.<br /><span class="text-accent">Sans prise de tête.</span>
            </h1>
            <p class="mt-6 max-w-xl text-lg text-paper/80 md:text-xl">
              Pose, entretien, dépannage et remplacement de climatisation. Un seul interlocuteur, un devis écrit et un prix ferme annoncé avant le chantier.
            </p>
          </>
        )}
        {accueilGeneraliste && <div class="mt-6 inline-flex flex-wrap items-center gap-x-3 gap-y-1 rounded-2xl border border-paper/15 bg-paper/5 px-4 py-3 text-sm">
          <span class="inline-flex items-center gap-2 font-semibold text-paper"><span class="h-2 w-2 rounded-full bg-accent"></span> Disponible maintenant : {actifs.map((s) => s.name).join(', ')}</span>
          {bientot.length > 0 && <span class="text-paper/60">Bientôt : {listeBientot}.</span>}
        </div>}
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#devis" class="btn btn-primary text-lg" data-track="CTA devis" data-place="hero">Demander un devis gratuit <Icon name="arrow" /></a>
          <a href={`tel:${site.phone.tel}`} class="btn btn-light text-lg" data-track="Appel" data-place="hero"><Icon name="phone" /> <span class="sr-only">Appeler le</span> {site.phone.display}</a>
        </div>
      </div>
      {accueilGeneraliste ? <EnergyVisual /> : <HeroVisual />}
    </div>
  </section>

  <!-- ATOUTS -->
  <section aria-label="En bref" class="relative z-10 -mt-10">
    <div class="container-site">
      <ul class="grid grid-cols-2 gap-3 rounded-3xl border border-line bg-white p-3 shadow-[0_20px_50px_-30px_rgba(16,36,58,.45)] md:grid-cols-4 md:gap-0 md:p-2">
        {atouts.map(([i, t, d], k) => (
          <li class:list={['flex flex-col gap-2 rounded-2xl p-4 md:flex-row md:items-center md:gap-4 md:p-5', k > 0 && 'md:rounded-none md:border-l md:border-line']}>
            <span class="chip-icon shrink-0"><Icon name={i} size={22} /></span>
            <span class="leading-tight">
              <span class="block font-display text-xl font-bold uppercase">{t}</span>
              <span class="block text-sm text-muted">{d}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="section" aria-labelledby="services-titre">
    <div class="container-site">
      <div class="reveal">
        <p class="eyebrow">{accueilGeneraliste ? 'Nos domaines' : 'Notre métier'}</p>
        <h2 id="services-titre" class="h2 uppercase">{accueilGeneraliste ? 'Ce que nous faisons pour votre logement' : 'Votre climatisation, de A à Z'}</h2>
      </div>

      {actifs.map((s) => (
        <article class="reveal mt-10 overflow-hidden rounded-[1.75rem] bg-ink text-paper md:grid md:grid-cols-[1.1fr_1fr]">
          <div class="p-7 md:p-12">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-accent text-ink"><Icon name={s.icon} size={26} /></span>
              <span class="text-sm font-semibold uppercase tracking-wider text-sun">{s.short}</span>
            </div>
            <h3 class="mt-5 text-[clamp(2rem,6vw,3rem)] uppercase">{s.name}</h3>
            <p class="mt-3 max-w-md text-lg font-medium">Frais l’été, chaud l’hiver, avec un seul équipement bien dimensionné.</p>
            <p class="mt-2 max-w-md text-paper/75">Climatisation mono et multisplit, réversible : pose, entretien, dépannage, remplacement.</p>
          </div>
          <ul class="grid grid-cols-2 gap-px bg-paper/10">
            {prestations.map(([i, t, d]) => (
              <li class="bg-ink p-6 md:p-8">
                <Icon name={i} size={28} class="text-accent" />
                <p class="mt-3 font-display text-2xl font-bold uppercase">{t}</p>
                <p class="mt-1 text-sm text-paper/70">{d}</p>
              </li>
            ))}
          </ul>
        </article>
      ))}

      {bientot.length > 0 && (
        <div class="reveal mt-8">
          <div>
            <h3 class="font-sans text-base font-semibold text-muted">Bientôt disponible</h3>
            <ul class="mt-3 grid gap-3 sm:grid-cols-3">
              {bientot.map((s) => (
                <li class="flex items-center gap-3 rounded-2xl border border-dashed border-line bg-white/60 p-4" aria-disabled="true">
                  <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-line text-muted"><Icon name={s.icon} size={22} /></span>
                  <span class="leading-tight">
                    <span class="block font-display text-lg font-bold uppercase">{s.name}</span>
                    <span class="block text-xs font-semibold text-muted">{s.short} · Bientôt</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
    </div>
  </section>

  <Realisations />

  <!-- ENGAGEMENTS -->
  <section class="section hero-dark" aria-labelledby="engagements-titre">
    <div class="container-site">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">Nos engagements</p>
        <h2 id="engagements-titre" class="h2 uppercase">Simple, clair, bien fait</h2>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {engagements.map(([i, t, d]) => (
          <li class="glass reveal p-6">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-accent text-ink"><Icon name={i} size={24} /></span>
            <h3 class="mt-5 text-2xl uppercase">{t}</h3>
            <p class="mt-2 text-paper/75">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Etapes />

  <!-- ZONE -->
  <section id="zone" class="section" aria-labelledby="zone-titre">
    <div class="container-site grid items-center gap-10 md:grid-cols-[1fr_1.15fr]">
      <div class="reveal">
        <p class="eyebrow">Zone d’intervention</p>
        <h2 id="zone-titre" class="h2 uppercase">Partout dans le {site.region}</h2>
        <p class="mt-4 text-lg text-muted">Du littoral à l’arrière-pays, nous intervenons dans tout le {site.region} : bord de mer, copropriétés, maisons, résidences secondaires.</p>
        <p class="mt-5 flex items-start gap-3 rounded-2xl bg-white p-4 font-medium ring-1 ring-line">
          <span class="chip-icon !h-10 !w-10 shrink-0"><Icon name="arrow" size={20} /></span>
          <span>Plus loin ? <span class="text-accent-strong">Sur demande, sans problème.</span> Dites-nous où vous êtes, nous étudions chaque projet.</span>
        </p>
        <a href="#devis" class="btn btn-primary mt-6">Nous parler de votre projet <Icon name="arrow" size={18} /></a>
      </div>
      <div class="reveal"><VarMap /></div>
    </div>
  </section>

  <Avis />

  <!-- FAQ -->
  <section id="faq" class="section" aria-labelledby="faq-titre">
    <div class="container-site grid gap-10 md:grid-cols-[1fr_1.6fr]">
      <div class="reveal">
        <p class="eyebrow">Questions fréquentes</p>
        <h2 id="faq-titre" class="h2 uppercase">Vos questions, nos réponses</h2>
        <p class="mt-4 text-muted">Une autre question ? <a href={`mailto:${site.email}`} class="font-semibold text-accent-strong underline">Écrivez-nous</a>.</p>
      </div>
      <div class="reveal -mt-10"><Faq items={faq} /></div>
    </div>
  </section>

  <DevisForm />
</Layout>
