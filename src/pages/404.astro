---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
---
<Layout title={`Page introuvable | ${site.name}`} description="Cette page n'existe pas." noindex>
  <div class="container-site py-24 text-center">
    <p class="eyebrow">Erreur 404</p>
    <h1 class="mt-3 text-5xl uppercase">Page introuvable</h1>
    <p class="mt-4 text-muted">La page que vous cherchez n’existe pas ou a été déplacée.</p>
    <a href="/" class="btn btn-primary mt-8">Retour à l’accueil</a>
  </div>
</Layout>
