---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import DevisForm from '../components/DevisForm.astro';
import Etapes from '../components/Etapes.astro';
import Realisations from '../components/Realisations.astro';
import Avis from '../components/Avis.astro';
import HeroVisual from '../components/HeroVisual.astro';
import { site } from '../config/site';
import { formules } from '../data/entretien';

const compris = [
  'Visite ou étude sur photos avant le devis',
  'Calcul de la puissance adaptée à votre logement',
  'Devis écrit et détaillé, avec un prix ferme',
  'Matériel de marque, références indiquées sur le devis',
  'Pose propre : sols protégés, liaisons discrètes, nettoyage final',
  'Mise en service, réglages, explications et facture claire',
];

const bonASavoir = [
  ['swap', 'Mono-split ou multi-split ?', 'Le mono-split climatise une pièce avec une unité intérieure. Le multi-split relie plusieurs unités à un seul groupe extérieur : idéal pour plusieurs pièces, avec un seul appareil dehors. Nous vous orientons selon votre logement, pas selon le catalogue.'],
  ['home', 'En copropriété, anticiper l’accord', 'Une unité extérieure en façade ou sur un balcon demande souvent l’accord de l’assemblée générale, parfois une déclaration en mairie. Nous fournissons le descriptif technique et plaçons l’unité pour limiter le bruit chez les voisins.'],
  ['drop', 'En bord de mer, protéger l’unité extérieure', 'L’air salin use plus vite les échangeurs. Emplacement abrité, matériel adapté quand le modèle le propose et entretien régulier prolongent nettement la durée de vie.'],
  ['calendar', 'Résidence secondaire ou location', 'Un entretien au printemps évite les mauvaises surprises à l’arrivée des vacanciers. Selon les modèles, un pilotage à distance permet de lancer le confort avant votre venue.'],
] as const;

const prestations = [
  ['ac', 'Installation', 'Clim mono ou multisplit, réversible pour rafraîchir l’été et chauffer l’hiver. Puissance calculée pour votre logement, pose soignée, mise en service et prise en main.'],
  ['shield', 'Entretien', 'Filtres, échangeurs, condensats, contrôle du fonctionnement. Visite ponctuelle ou contrat annuel : votre équipement consomme moins et dure plus longtemps.'],
  ['wrench', 'Dépannage', 'Plus de froid ou de chauffage, fuite d’eau, code erreur, bruit anormal : diagnostic sur place et prix annoncé avant toute réparation.'],
  ['swap', 'Remplacement', 'Appareil ancien, énergivore ou en panne : dépose, récupération des fluides dans les règles et pose d’un équipement récent, plus sobre et plus silencieux.'],
] as const;

const faq = [
  { q: 'Combien coûte une climatisation ?', a: 'Le prix dépend du type d’équipement (monosplit ou multisplit), de la puissance nécessaire, du nombre de pièces et de l’accès au chantier. Après une courte visite ou l’envoi de quelques photos, vous recevez un devis écrit avec un prix ferme : c’est ce prix qui est facturé.' },
  { q: 'Une clim peut-elle aussi chauffer ?', a: 'Oui : une climatisation réversible rafraîchit l’été et chauffe l’hiver, pièce par pièce. En mi-saison et dans notre climat, elle peut suffire à chauffer une grande partie du logement. Nous vous conseillons selon votre logement, votre chauffage actuel et vos priorités.' },
  { q: 'Quelle puissance faut-il ?', a: 'Elle dépend de la surface, de l’orientation, de l’isolation et des ouvertures. Un appareil trop petit force, un appareil trop grand s’use vite : nous la calculons pour votre logement.' },
  { q: 'Quand faut-il prévoir l’installation ?', a: 'Le délai dépend du matériel choisi et de la saison : il est indiqué sur le devis. Pour la clim, mieux vaut anticiper avant l’été, quand les plannings se remplissent.' },
  { q: 'L’entretien d’une clim est-il obligatoire ?', a: 'Pour les climatisations réversibles d’une puissance entre 4 et 70 kW, la réglementation impose un entretien au moins tous les deux ans. Des contrôles d’étanchéité peuvent s’ajouter selon la quantité de fluide frigorigène. Nous vous indiquons ce qui s’applique à votre équipement. Dans tous les cas, un entretien régulier est recommandé : il préserve les performances, limite la consommation et prolonge la durée de vie de l’appareil.' },
  { q: 'Existe-t-il des aides financières ?', a: 'Les climatisations sont en général peu ou pas aidées. Nous vous disons clairement, au moment du devis, si quelque chose est envisageable pour votre projet. Le site officiel france-renov.gouv.fr permet aussi de faire le point.' },
  { q: 'Intervenez-vous en cas de panne ?', a: 'Oui : diagnostic sur place et prix annoncé avant toute réparation. Les clients sous contrat Sérénité sont dépannés en priorité sous 48 h.' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Climatisation à Hyères', item: new URL('/climatisation-hyeres', Astro.site).href },
  ],
};
---
<Layout
  title="Climatisation à Hyères : pose, entretien, dépannage | La Cigale Énergie"
  description="Installation, entretien, dépannage et remplacement de climatisation à Hyères, Giens, La Londe, Carqueiranne, dans le Var et alentours. Devis gratuit, prix ferme, réponse sous 24 h ouvrées."
  jsonld={[faqLd, crumbLd]}
>
  <!-- HERO -->
  <section class="hero-dark">
    <div class="container-site grid items-center gap-14 pb-20 pt-10 md:grid-cols-[1.15fr_1fr] md:pb-28 md:pt-16">
      <div>
        <nav aria-label="Fil d’Ariane" class="text-sm text-paper/60">
          <a href="/" class="hover:text-paper hover:underline">Accueil</a> <span aria-hidden="true">/</span> <span aria-current="page">Climatisation à {site.city}</span>
        </nav>
        <h1 class="mt-5">
          <span class="eyebrow block">Climatisation à {site.city}</span>
          <span class="mt-3 block text-[clamp(2.6rem,9.5vw,4.4rem)] uppercase">Le frais l’été,<br />le chaud l’hiver.<br /><span class="text-accent">Sans prise de tête.</span></span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-paper/80">Du littoral à l’arrière-pays varois, nous connaissons les contraintes locales : copropriétés en centre ancien, maisons exposées au vent et à l’air salin près du littoral, résidences secondaires à préparer avant l’été.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#devis" class="btn btn-primary text-lg" data-track="CTA devis" data-place="clim-hero">Demander un devis gratuit <Icon name="arrow" /></a>
          <a href={`tel:${site.phone.tel}`} class="btn btn-light text-lg" data-track="Appel" data-place="clim-hero"><Icon name="phone" /> {site.phone.display}</a>
        </div>
        <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-sun">Installation · Entretien · Dépannage · Remplacement</p>
      </div>
      <HeroVisual />
    </div>
  </section>

  <!-- CE QUI EST COMPRIS -->
  <section aria-labelledby="compris-titre" class="relative z-10 -mt-10">
    <div class="container-site">
      <div class="rounded-3xl border border-line bg-white p-6 shadow-[0_20px_50px_-30px_rgba(16,36,58,.45)] md:p-8">
        <h2 id="compris-titre" class="text-2xl uppercase">Ce qui est compris</h2>
        <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
          {compris.map((c) => (
            <li class="flex items-start gap-3"><span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent-strong"><Icon name="check" size={16} /></span>{c}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- BON À SAVOIR -->
  <section class="section" aria-labelledby="bas-titre">
    <div class="container-site">
      <div class="reveal">
        <p class="eyebrow">Bon à savoir</p>
        <h2 id="bas-titre" class="h2 uppercase">Bien préparer votre projet à {site.city}</h2>
      </div>
      <ul class="mt-10 grid gap-5 md:grid-cols-2">
        {bonASavoir.map(([i, t, d]) => (
          <li class="card reveal flex gap-5 p-6 md:p-8">
            <span class="chip-icon shrink-0"><Icon name={i} size={22} /></span>
            <div>
              <h3 class="text-2xl uppercase">{t}</h3>
              <p class="mt-2 text-muted">{d}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PRESTATIONS -->
  <section class="section bg-white" aria-labelledby="prestations-titre">
    <div class="container-site">
      <div class="reveal">
        <p class="eyebrow">Nos prestations</p>
        <h2 id="prestations-titre" class="h2 uppercase">Tout pour votre climatisation</h2>
      </div>
      <ul class="mt-10 grid gap-5 md:grid-cols-2">
        {prestations.map(([i, t, d], k) => (
          <li class="card card-hover reveal flex flex-col p-6 md:p-8">
            <div class="flex items-center justify-between">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-accent text-ink"><Icon name={i} size={26} /></span>
              <span class="font-display text-4xl font-bold text-line">0{k + 1}</span>
            </div>
            <h3 class="mt-4 text-3xl uppercase">{t}</h3>
            <p class="mt-2 flex-1 text-muted">{d}</p>
            <a href="#devis" data-besoin={t} class="mt-5 inline-flex items-center gap-2 font-semibold text-accent-strong hover:underline" data-track="CTA devis" data-place={`prestation-${t}`}>Demander un devis : {t.toLowerCase()} <Icon name="arrow" size={18} /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ENTRETIEN -->
  <section id="entretien" class="section" aria-labelledby="entretien-titre">
    <div class="container-site">
      <div class="reveal">
        <p class="eyebrow">Entretien annuel</p>
        <h2 id="entretien-titre" class="h2 uppercase">Trois formules, au choix</h2>
        <p class="mt-3 max-w-2xl text-muted">Choisissez le niveau d’entretien qui vous convient. Le tarif dépend du nombre d’unités : il figure sur votre devis gratuit.</p>
      </div>
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {formules.map((f) => (
          <li class:list={['card card-hover reveal relative flex flex-col p-6 md:p-8', f.vedette && 'border-2 !border-accent bg-ink text-paper md:-translate-y-3']}>
            {f.vedette && <span class="absolute -top-3 left-6 rounded-full bg-sun px-3 py-1 text-sm font-semibold text-ink">Le plus choisi</span>}
            <h3 class="text-3xl uppercase">{f.nom}</h3>
            <p class:list={['mt-1 mb-1', f.vedette ? 'text-paper/75' : 'text-muted']}>{f.accroche}</p>
            <ul class="mt-5 space-y-2">
              {f.inclus.map((i) => (
                <li class="flex items-start gap-2"><Icon name="check" size={20} class={`mt-0.5 shrink-0 ${f.vedette ? 'text-accent' : 'text-accent-strong'}`} />{i}</li>
              ))}
            </ul>
            <a href="#devis" data-besoin="Entretien" class:list={['btn mt-auto w-full', f.vedette ? 'btn-primary' : 'btn-ghost']} style="margin-top:1.75rem" data-track="CTA formule" data-place={f.nom}>Demander cette formule</a>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-muted">Remises selon le nombre d’unités et l’engagement. Contrats sur mesure pour commerces, agences et syndics.</p>
    </div>
  </section>

  <Realisations titre="Nos chantiers en climatisation" />

  <Etapes />

  <Avis />

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-titre">
    <div class="container-site grid gap-10 md:grid-cols-[1fr_1.6fr]">
      <div class="reveal">
        <p class="eyebrow">Questions fréquentes</p>
        <h2 id="faq-titre" class="h2 uppercase">Climatisation : vos questions</h2>
        <p class="mt-4 text-muted">Une autre question ? <a href={`mailto:${site.email}`} class="font-semibold text-accent-strong underline">Écrivez-nous</a>.</p>
        <div class="mt-8 rounded-2xl bg-accent-soft p-5">
          <p class="flex items-start gap-3"><Icon name="pin" class="mt-1 shrink-0 text-accent-strong" /> <span>Nous intervenons {site.zoneText}. {site.zoneFar}</span></p>
          <a href="/#zone" class="mt-3 inline-block font-semibold text-accent-strong underline">Voir la zone</a>
        </div>
      </div>
      <div class="reveal -mt-10"><Faq items={faq} /></div>
    </div>
  </section>

  <DevisForm />
</Layout>
