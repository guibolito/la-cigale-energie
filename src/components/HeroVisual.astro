---
// Illustration du hero : clim murale animée + badges flottants.
import Icon from './Icon.astro';
---
<div class="relative mx-auto w-full max-w-md" aria-hidden="true">
  <div class="glass relative p-6 md:p-8">
    <div class="flex items-center justify-between text-sm text-paper/70">
      <span class="inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-accent"></span> Mode confort</span>
      <span>Var · été</span>
    </div>
    <svg viewBox="0 0 320 210" class="mt-4 h-auto w-full">
      <defs>
        <linearGradient id="acg" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset="1" stop-color="#e7edf2" />
        </linearGradient>
      </defs>
      <rect x="30" y="20" width="260" height="70" rx="18" fill="url(#acg)" />
      <rect x="30" y="72" width="260" height="18" rx="9" fill="#d5dee6" />
      <path d="M52 80h216" stroke="#b9c6d1" stroke-width="3" stroke-linecap="round" />
      <circle cx="262" cy="42" r="4" fill="var(--accent)" />
      <text x="60" y="56" font-family="Barlow Condensed, sans-serif" font-weight="700" font-size="26" fill="var(--ink)">22°</text>
      <g class="airflow" fill="none" stroke="var(--accent)" stroke-width="4" stroke-linecap="round">
        <path d="M90 104c-6 24-18 44-34 64" />
        <path d="M160 106v78" />
        <path d="M230 104c6 24 18 44 34 64" />
      </g>
    </svg>
    <div class="mt-2 grid grid-cols-3 gap-3 text-center">
      <div class="rounded-2xl bg-paper/10 p-3"><p class="font-display text-2xl font-bold">22°</p><p class="text-xs text-paper/70">Intérieur</p></div>
      <div class="rounded-2xl bg-paper/10 p-3"><p class="font-display text-2xl font-bold text-sun">34°</p><p class="text-xs text-paper/70">Dehors</p></div>
      <div class="rounded-2xl bg-paper/10 p-3"><p class="font-display text-2xl font-bold">2 en 1</p><p class="text-xs text-paper/70">Chaud &amp; froid</p></div>
    </div>
  </div>
  <div class="floaty absolute -left-6 -top-10 hidden items-center gap-2 rounded-2xl bg-paper px-4 py-3 text-ink shadow-xl sm:flex">
    <span class="chip-icon !h-9 !w-9"><Icon name="doc" size={18} /></span>
    <span class="text-sm font-semibold leading-tight">Devis gratuit<br /><span class="font-normal text-muted">prix ferme</span></span>
  </div>
  <div class="floaty-2 absolute -bottom-6 -right-4 hidden items-center gap-2 rounded-2xl bg-sun px-4 py-3 text-ink shadow-xl sm:flex">
    <Icon name="clock" size={20} />
    <span class="text-sm font-semibold">Réponse sous 24 h</span>
  </div>
</div>
