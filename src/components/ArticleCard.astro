---
import Icon from './Icon.astro';
interface Props { slug: string; titre: string; resume: string; date: Date }
const { slug, titre, resume, date } = Astro.props;
---
<a href={`/blog/${slug}`} class="card card-hover group flex h-full flex-col p-6">
  <time datetime={date.toISOString().slice(0, 10)} class="text-sm font-semibold uppercase tracking-wider text-accent-strong">{date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
  <h3 class="mt-3 text-2xl uppercase leading-tight">{titre}</h3>
  <p class="mt-3 flex-1 text-muted">{resume}</p>
  <span class="mt-5 inline-flex items-center gap-2 font-semibold text-accent-strong">Lire l’article <Icon name="arrow" size={18} class="transition group-hover:translate-x-1" /></span>
</a>
